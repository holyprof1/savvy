<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Our Work - Savvy Media Africa - Culture-Moving Campaigns</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>

<!-- Global header + footer styles -->
<link rel="stylesheet" href="/assets/css/savvy.css?v=202609122144">

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}


body{
  font-family:'Sora',sans-serif;
  color:var(--white);
  background:var(--deep-navy);
  overflow-x:hidden;
  line-height:1.6;
  font-weight:400;
  cursor:none
}

.cursor{
  position:fixed;
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--bright-cyan);
  pointer-events:none;
  z-index:99999;
  opacity:.8;
  transition:transform .1s ease;
  mix-blend-mode:screen;
  box-shadow:0 0 12px var(--bright-cyan),0 0 24px rgba(0,212,255,.5)
}

.cursor-follower{
  position:fixed;
  width:32px;
  height:32px;
  border-radius:50%;
  border:1.5px solid var(--bright-cyan);
  pointer-events:none;
  z-index:99998;
  opacity:.4;
  transition:all .25s ease;
  box-shadow:inset 0 0 8px rgba(0,212,255,.3)
}

h1,h2,h3,h4,h5,h6{font-weight:500;line-height:1.1;letter-spacing:-0.02em}
h1{font-size:clamp(3rem,9vw,10rem)}
h2{font-size:clamp(2.2rem,6vw,5.5rem)}
h3{font-size:clamp(1.6rem,4vw,2.8rem)}

.underline-text{display:inline-block;position:relative;padding-bottom:6px}
.underline-text::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:4px;background:var(--bright-cyan);border-radius:2px}
.underline-green::after{background:var(--bright-green)}
.underline-orange::after{background:var(--orange)}

/* ========== HERO ========== */
.hero{
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  position:relative;
  padding:12rem 4rem 6rem;
  overflow:hidden;
  background:linear-gradient(135deg,var(--deep-navy) 0%,var(--navy) 100%)
}

.floating-shape{
  position:absolute;
  border-radius:50%;
  filter:blur(120px);
  opacity:.12;
  pointer-events:none;
  animation:float 20s ease-in-out infinite
}

.shape-1{
  width:700px;
  height:700px;
  background:linear-gradient(135deg,var(--bright-cyan),var(--cyan));
  top:10%;
  left:5%
}

.shape-2{
  width:600px;
  height:600px;
  background:linear-gradient(135deg,var(--orange),var(--yellow));
  bottom:6%;
  right:5%;
  animation-delay:-10s
}

@keyframes float{
  0%,100%{transform:translate(0,0) scale(1)}
  25%{transform:translate(50px,-50px) scale(1.1)}
  50%{transform:translate(80px,-80px) scale(1.2)}
  75%{transform:translate(30px,-40px) scale(1.15)}
}

.hero-content{text-align:center;max-width:1600px;position:relative;z-index:2}

.hero-title{
  font-family:'Sora',sans-serif;
  font-size:clamp(3rem,9.6vw,10.6rem);
  font-weight:500;
  line-height:1.05;
  margin-bottom:1.6rem
}

.title-line{display:block;margin-bottom:.6rem}

.word{
  display:inline-block;
  margin-right:.25em;
  position:relative;
  opacity:0;
  transform:translate3d(0,100px,0) scale(.9) rotate(4deg)
}

.word.cyan{color:var(--bright-cyan)}
.word.green{color:var(--bright-green)}
.word.orange{color:var(--orange)}

.word.gradient-cyan{
  background:linear-gradient(135deg,var(--bright-cyan),var(--cyan));
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
  color:transparent;
  display:inline;
  line-height:1
}

.hero-subtitle{
  font-size:clamp(1.05rem,2vw,1.35rem);
  color:rgba(255,255,255,.9);
  max-width:900px;
  margin:1.1rem auto 0;
  line-height:1.9;
  opacity:0;
  font-weight:400
}

/* ========== SECTIONS ========== */
.section{padding:var(--section-pad) 2rem}

.section-label{
  display:inline-block;
  background:linear-gradient(135deg,var(--orange),var(--yellow));
  color:var(--deep-navy);
  padding:.7rem 1.6rem;
  border-radius:999px;
  font-size:.88rem;
  font-weight:500;
  text-transform:uppercase;
  letter-spacing:2px;
  margin-bottom:1.2rem
}

.section-title{
  font-size:clamp(2.6rem,6vw,5.5rem);
  font-weight:500;
  margin-bottom:.8rem;
  text-align:center
}

.section-subtitle{
  font-size:1.25rem;
  color:rgba(255,255,255,.85);
  text-align:center;
  max-width:900px;
  margin:0 auto 3rem;
  font-weight:400
}

.title-animate{display:inline-block;overflow:hidden}
.title-animate .tword{display:inline-block;transform:translateY(115%);opacity:0}

/* ========== PORTFOLIO GRID ========== */
.portfolio-section{
  padding:var(--section-pad) 2rem;
  background:var(--navy)
}

.portfolio-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
  gap:3rem;
  max-width:1600px;
  margin:0 auto
}

.portfolio-card{
  position:relative;
  border-radius:24px;
  overflow:hidden;
  background:rgba(255,255,255,.04);
  backdrop-filter:blur(10px);
  border:1px solid rgba(0,212,255,.15);
  transition:.45s;
  opacity:0;
  transform:translateY(50px);
  cursor:pointer;
  min-height:360px;
  height:auto;
  display:flex;
  flex-direction:column;
}

.portfolio-card::before{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(135deg,rgba(0,212,255,.2) 0%,rgba(255,107,53,.2) 100%);
  opacity:0;
  transition:.45s;
  pointer-events:none;
  z-index:3
}

.portfolio-card:hover{
  border-color:rgba(0,212,255,.4);
  transform:translateY(-12px);
  box-shadow:0 20px 60px rgba(0,212,255,.2)
}

.portfolio-card:hover::before{
  opacity:1
}

.portfolio-image{
  width:100%;
  height:220px;
  overflow:hidden;
  position:relative;
  flex-shrink:0;
  background:var(--navy);
  display:flex;
  align-items:center;
  justify-content:center
}

.portfolio-image::after{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,29,61,.5) 100%);
  z-index:2;
  pointer-events:none
}

.portfolio-image img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:top center;
  transition:transform .6s;
  position:relative;
  z-index:1;
}

.portfolio-card:hover .portfolio-image img{
  transform:scale(1.12)
}

.portfolio-info{
  padding:2rem;
  position:relative;
  z-index:2;
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  background:linear-gradient(180deg,rgba(0,29,61,.3) 0%,rgba(0,29,61,.8) 100%)
}

.portfolio-category{
  font-size:.85rem;
  color:var(--bright-green);
  text-transform:uppercase;
  letter-spacing:2px;
  font-weight:600;
  margin-bottom:.8rem;
  display:inline-block;
  background:rgba(0,255,136,.1);
  padding:.4rem .8rem;
  border-radius:999px;
  width:fit-content
}

.portfolio-title{
  font-size:1.6rem;
  font-weight:600;
  margin-bottom:.8rem;
  color:var(--white);
  line-height:1.2
}

.portfolio-description{
  font-size:.95rem;
  color:rgba(255,255,255,.8);
  line-height:1.6
}

/* ========== FEATURED PROJECT ========== */
.featured-section{
  padding:var(--section-pad) 2rem;
  background:linear-gradient(135deg,rgba(0,212,255,.05) 0%,rgba(255,107,53,.05) 100%);
  border-top:2px solid rgba(0,212,255,.2);
  border-bottom:2px solid rgba(0,212,255,.2)
}

.featured-container{
  max-width:1600px;
  margin:0 auto
}

.featured-header{
  text-align:center;
  margin-bottom:4rem
}

.featured-header h2{
  margin-bottom:1rem
}

.featured-project{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:4rem;
  align-items:center;
  opacity:0;
  transform:translateY(50px)
}

.featured-images{
  position:relative;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:2rem
}

.featured-img-main{
  grid-column:1/-1;
  border-radius:20px;
  overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,.4)
}

.featured-img-main img{
  width:100%;
  height:auto;
  display:block;
  transition:transform .6s;
  object-fit:cover
}

.featured-project:hover .featured-img-main img{
  transform:scale(1.05)
}

.featured-img-small{
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 15px 40px rgba(0,0,0,.3);
  height:280px
}

.featured-img-small img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .6s
}

.featured-project:hover .featured-img-small img{
  transform:scale(1.08)
}

.featured-content{
  position:relative;
  z-index:2
}

.featured-client{
  color:var(--bright-cyan);
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:2px;
  margin-bottom:.8rem;
  font-size:.95rem
}

.featured-title{
  font-size:clamp(2rem,5vw,3.5rem);
  font-weight:600;
  margin-bottom:2rem;
  line-height:1.2
}

.featured-challenge,.featured-solution,.featured-results{
  margin-bottom:2.4rem
}

.featured-label{
  font-size:.95rem;
  color:var(--bright-green);
  text-transform:uppercase;
  letter-spacing:2px;
  font-weight:700;
  margin-bottom:.8rem
}

.featured-text{
  font-size:1.1rem;
  line-height:1.85;
  color:rgba(255,255,255,.9);
  margin-bottom:0
}

.results-metrics{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:1.5rem;
  margin-top:2rem
}

.metric{
  background:rgba(0,212,255,.1);
  border:1px solid rgba(0,212,255,.2);
  padding:1.5rem;
  border-radius:16px;
  text-align:center;
  transition:.35s
}

.metric:hover{
  background:rgba(0,212,255,.2);
  border-color:rgba(0,212,255,.4)
}

.metric-number{
  font-size:2.4rem;
  font-weight:700;
  background:linear-gradient(135deg,var(--bright-cyan),var(--orange));
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
  margin-bottom:.5rem
}

.metric-label{
  font-size:.95rem;
  color:rgba(255,255,255,.8);
  text-transform:uppercase;
  letter-spacing:1.5px;
  font-weight:500
}

/* ========== CASE STUDIES CAROUSEL ========== */
.case-studies-section{
  padding:var(--section-pad) 2rem;
  background:var(--deep-navy)
}

.case-swiper-container{
  max-width:1600px;
  margin:0 auto
}

.swiper-slide{
  height:auto !important
}

.case-study-card{
  background:rgba(255,255,255,.04);
  border-radius:24px;
  overflow:hidden;
  border:1px solid rgba(0,212,255,.15);
  transition:.45s;
  display:flex;
  flex-direction:column;
  height:100%;
}

.case-study-card:hover{
  border-color:rgba(0,212,255,.3);
  transform:translateY(-8px);
  box-shadow:0 25px 60px rgba(0,212,255,.15)
}

.case-image{
  width:100%;
  height:280px;
  overflow:hidden;
  position:relative;
  background:var(--navy);
  display:flex;
  align-items:center;
  justify-content:center
}

.case-image img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  transition:transform .6s
}

.case-study-card:hover .case-image img{
  transform:scale(1.1)
}

.case-content{
  padding:2.4rem;
  flex:1;
  display:flex;
  flex-direction:column;
  background:linear-gradient(180deg,rgba(0,29,61,.3) 0%,rgba(0,29,61,.9) 100%)
}

.case-client{
  font-size:.9rem;
  color:var(--bright-cyan);
  text-transform:uppercase;
  letter-spacing:2px;
  font-weight:600;
  margin-bottom:1rem;
  display:inline-block;
  background:rgba(0,212,255,.1);
  padding:.5rem 1rem;
  border-radius:999px;
  border:1px solid rgba(0,212,255,.3);
  width:fit-content
}

.case-title{
  font-size:1.8rem;
  font-weight:600;
  margin-bottom:1.5rem;
  color:var(--white);
  line-height:1.2
}

.case-challenge{
  margin-bottom:1.8rem;
  padding-bottom:1.8rem;
  border-bottom:1px solid rgba(0,212,255,.1)
}

.case-challenge-label{
  font-size:.85rem;
  color:var(--bright-green);
  text-transform:uppercase;
  letter-spacing:1.5px;
  font-weight:600;
  margin-bottom:.6rem;
  display:block
}

.case-challenge-text{
  font-size:1rem;
  line-height:1.7;
  color:rgba(255,255,255,.85)
}

.case-solution{
  margin-bottom:1.8rem;
  padding-bottom:1.8rem;
  border-bottom:1px solid rgba(0,212,255,.1)
}

.case-solution-label{
  font-size:.85rem;
  color:var(--bright-green);
  text-transform:uppercase;
  letter-spacing:1.5px;
  font-weight:600;
  margin-bottom:.6rem;
  display:block
}

.case-solution-text{
  font-size:1rem;
  line-height:1.7;
  color:rgba(255,255,255,.85)
}

.case-results{
  margin-top:auto
}

.case-results-label{
  font-size:.85rem;
  color:var(--bright-green);
  text-transform:uppercase;
  letter-spacing:1.5px;
  font-weight:600;
  margin-bottom:.8rem;
  display:block
}

.case-results-text{
  font-size:1rem;
  line-height:1.8;
  color:rgba(255,255,255,.85);
  background:rgba(0,255,136,.08);
  padding:1rem;
  border-radius:12px;
  border-left:3px solid var(--bright-green)
}

.swiper-pagination{
  margin-top:3rem !important
}

.swiper-pagination-bullet{
  background:rgba(0,212,255,.4);
  width:12px;
  height:12px;
  opacity:1
}

.swiper-pagination-bullet-active{
  background:var(--bright-cyan)
}

/* ========== IMPACT SECTION ========== */
.stats-section{
  padding:var(--section-pad) 2rem;
  background:var(--navy)
}

.stats-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:3rem;
  max-width:1400px;
  margin:0 auto;
  margin-top:2rem
}

.stat-card{
  text-align:center;
  opacity:0;
  transform:scale(.8);
  position:relative;
  padding:2.4rem 2rem;
  background:rgba(0,212,255,.05);
  border:1px solid rgba(0,212,255,.15);
  border-radius:20px;
  transition:.45s;
  overflow:hidden
}

.stat-card::before{
  content:'';
  position:absolute;
  inset:0;
  background:radial-gradient(500px 500px at 50% 50%,rgba(0,212,255,.1),transparent);
  opacity:0;
  transition:.4s;
  pointer-events:none
}

.stat-card:hover{
  transform:scale(1);
  border-color:rgba(0,212,255,.3);
  background:rgba(0,212,255,.08)
}

.stat-card:hover::before{
  opacity:1
}

.stat-number{
  font-size:clamp(2.5rem,6vw,4rem);
  font-weight:700;
  background:linear-gradient(135deg,var(--bright-cyan),var(--orange));
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
  margin-bottom:.8rem;
  position:relative;
  z-index:1
}

.stat-label{
  font-size:1.2rem;
  font-weight:600;
  color:var(--white);
  position:relative;
  z-index:1
}

/* ========== CTA SECTION ========== */
.cta-section{
  padding:var(--section-pad) 2rem;
  background:linear-gradient(135deg,var(--bright-cyan),var(--orange));
  text-align:center
}

.cta-title{
  font-family:'Sora',sans-serif;
  font-size:clamp(2.6rem,7vw,5.5rem);
  font-weight:500;
  margin-bottom:.6rem;
  color:var(--deep-navy)
}

.cta-subtitle{
  font-size:1.4rem;
  margin-bottom:2.2rem;
  opacity:.96;
  color:var(--deep-navy);
  font-weight:400
}

.btn-primary{
  background:var(--deep-navy);
  color:var(--bright-cyan);
  padding:1.1rem 2.8rem;
  border-radius:999px;
  text-decoration:none;
  font-weight:500;
  font-size:1.05rem;
  display:inline-flex;
  align-items:center;
  gap:.7rem;
  box-shadow:0 10px 40px rgba(0,0,0,.3);
  opacity:0;
  transition:transform .2s,box-shadow .2s;
  border:none;
  cursor:pointer
}

.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 15px 50px rgba(0,0,0,.4)
}

/* ========== SCROLL TOP ========== */
.scroll-top{
  position:fixed;
  bottom:26px;
  right:26px;
  width:68px;
  height:68px;
  border-radius:50%;
  z-index:9000;
  display:grid;
  place-items:center;
  cursor:pointer;
  background:conic-gradient(var(--bright-cyan) calc(var(--scroll,0)*1%),rgba(0,212,255,.15) 0);
  box-shadow:0 12px 35px rgba(0,212,255,.38),inset 0 0 0 8px rgba(0,29,61,.5);
  transform:scale(.9) rotate(0deg);
  opacity:0;
  pointer-events:none;
  transition:.25s ease;
  border:none
}

.scroll-top.visible{
  opacity:1;
  pointer-events:auto;
  transform:scale(1) rotate(0deg);
}

.scroll-top.scrolling{
  animation:rotateProgress 0.8s linear infinite;
}

@keyframes rotateProgress{
  0%{transform:scale(1) rotate(0deg)}
  100%{transform:scale(1) rotate(360deg)}
}

.scroll-top .inner{
  width:50px;
  height:50px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:var(--navy);
  color:#fff;
  font-weight:500
}

.scroll-top .pct{font-size:.92rem}

/* ========== RESPONSIVE ========== */
@media (max-width:1200px){
  .portfolio-grid{grid-template-columns:repeat(2,1fr)}
  .results-metrics{grid-template-columns:1fr}
}

@media (max-width:1024px){
  .featured-project{grid-template-columns:1fr}
  .featured-images{grid-template-columns:1fr}
  .featured-img-main{grid-column:1}
}

@media (max-width:768px){
  :root{--section-pad:4rem}
  .portfolio-grid{grid-template-columns:1fr}
  body{cursor:default}
  .cursor,.cursor-follower{display:none}
}
</style>

</head>
<body>

<!-- Custom Cursor -->
<div class="cursor"></div>
<div class="cursor-follower"></div>

<!-- Header include (this is what include.js needs) -->
<div data-include="/partials/header.html"></div>

<!-- ========== HERO ========== -->
<section class="hero">
  <div class="floating-shape shape-1" data-parallax="-12"></div>
  <div class="floating-shape shape-2" data-parallax="14"></div>

  <div class="hero-content">
    <h1 class="hero-title">
      <div class="title-line">
        <span class="word">Work</span>
        <span class="word cyan">That</span>
      </div>
      <div class="title-line">
        <span class="word green">Moves</span>
        <span class="word orange">Culture</span>
      </div>
      <div class="title-line">
        <span class="word">& <span class="gradient-cyan">Delivers</span></span>
        <span class="word">Results</span>
      </div>
    </h1>

    <p class="hero-subtitle">Campaigns that sparked conversations, moved markets, and proved African creativity is world-class. Here's what we've built.</p>
  </div>
</section>

<!-- ========== PORTFOLIO GRID ========== -->
<section class="portfolio-section section">
  <div style="text-align:center;margin-bottom:3rem">
    <span class="section-label">Our Portfolio</span>
    <h2 class="section-title title-animate"><span class="tword">Featured</span> <span class="tword">Projects</span></h2>
    <p class="section-subtitle">A selection of campaigns that show our range and impact</p>
  </div>

  <div class="portfolio-grid">
    <!-- House of Tara -->
    <div class="portfolio-card">
      <div class="portfolio-image">
        <img src="/assets/img/tara.png" alt="House of Tara Legacy">
      </div>
      <div class="portfolio-info">
