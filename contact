// Contact Form Handling (front-end only)
const contactForm    = document.getElementById('contactForm');
const successMessage = document.getElementById('successMessage');
const errorMessage   = document.getElementById('errorMessage');
const submitBtn      = document.getElementById('submitBtn');
const formTime       = document.getElementById('formTime');

/* Stamp render time so the server can reject instant bot submissions */
if (formTime) formTime.value = Math.floor(Date.now() / 1000);

contactForm.addEventListener('submit', async function (e) {
  e.preventDefault();

  successMessage.classList.remove('show');
  errorMessage.classList.remove('show');

  const original = submitBtn.innerHTML;
  submitBtn.disabled = true;
  submitBtn.innerHTML = 'Sending… <i class="fas fa-spinner fa-spin"></i>';

  try {
    const response = await fetch('/api/send-brief.php', {
      method: 'POST',
      body: new FormData(contactForm)
    });

    let result = {};
    try { result = await response.json(); } catch (_) { /* non-JSON response */ }

    if (response.ok && result.ok) {
      successMessage.classList.add('show');
      contactForm.reset();
      if (formTime) formTime.value = Math.floor(Date.now() / 1000);
      setTimeout(() => successMessage.classList.remove('show'), 6000);
    } else {
      errorMessage.textContent = result.error
        || 'Something went wrong. Please email hello@savvymediaafrica.com directly.';
      errorMessage.classList.add('show');
    }
  } catch (err) {
    errorMessage.textContent =
      'We could not reach the server. Please check your connection, or email hello@savvymediaafrica.com.';
    errorMessage.classList.add('show');
  } finally {
    submitBtn.disabled = false;
    submitBtn.innerHTML = original;
  }
});

// Scroll-to-top
const scrollBtn = document.getElementById('scrollTopBtn');
const scrollPct = document.getElementById('scrollPct');
let scrollTimeout;

function setScrollProgress(){
  const st = window.scrollY;
  const h  = document.documentElement.scrollHeight - innerHeight;
  const p  = h>0 ? Math.round((st/h)*100) : 0;
  document.documentElement.style.setProperty('--scroll',p);
  scrollBtn.style.setProperty('--scroll',p);
  scrollPct.textContent = p + '%';

  if(st>380){
    scrollBtn.classList.add('visible');
    scrollBtn.classList.add('scrolling');
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(()=>scrollBtn.classList.remove('scrolling'),500);
  } else {
    scrollBtn.classList.remove('visible','scrolling');
    clearTimeout(scrollTimeout);
  }
}

setScrollProgress();
window.addEventListener('scroll',setScrollProgress,{passive:true});
scrollBtn.addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));
</script>

