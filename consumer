<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Consumer Brands - Savvy Media Africa</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- Global header/footer + nav styles -->
<link rel="stylesheet" href="/assets/css/savvy.css">

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}


body{
  font-family:'Sora',sans-serif;
  color:var(--white);
  background:var(--deep-navy);
  overflow-x:hidden;
  line-height:1.6;
  font-weight:400;
  cursor:none;
}

.cursor{
  position:fixed;
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--bright-cyan);
  pointer-events:none;
  z-index:99999;
  opacity:.8;
  transition:transform .1s ease;
  mix-blend-mode:screen;
  box-shadow:0 0 12px var(--bright-cyan),0 0 24px rgba(0,212,255,.5)
}
.cursor-follower{
  position:fixed;
  width:32px;
  height:32px;
  border-radius:50%;
  border:1.5px solid var(--bright-cyan);
  pointer-events:none;
  z-index:99998;
  opacity:.4;
  transition:all .25s ease;
  box-shadow:inset 0 0 8px rgba(0,212,255,.3)
}

/* ========== HERO ========== */
.hero{
  min-height:90vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  position:relative;
  padding:12rem 4rem 6rem;
  overflow:hidden;
  background:linear-gradient(135deg,var(--deep-navy) 0%,var(--navy) 100%);
}
.floating-shape{
  position:absolute;
  border-radius:50%;
  filter:blur(120px);
  opacity:.12;
  pointer-events:none;
  animation:float 20s ease-in-out infinite;
}
.shape-1{
  width:700px;
  height:700px;
  background:linear-gradient(135deg,var(--bright-cyan),var(--cyan));
  top:10%;
  left:5%;
}
.shape-2{
  width:600px;
  height:600px;
  background:linear-gradient(135deg,var(--orange),var(--yellow));
  bottom:6%;
  right:5%;
  animation-delay:-10s;
}
@keyframes float{
  0%,100%{transform:translate(0,0) scale(1)}
  25%{transform:translate(50px,-50px) scale(1.1)}
  50%{transform:translate(80px,-80px) scale(1.2)}
  75%{transform:translate(30px,-40px) scale(1.15)}
}
.hero-content{
  text-align:center;
  max-width:1600px;
  position:relative;
  z-index:2;
}
.hero-title{
  font-family:'Sora',sans-serif;
  font-size:clamp(2.8rem,9vw,7rem);
  font-weight:500;
  line-height:1.05;
  margin-bottom:2rem;
}
.title-line{display:block;margin-bottom:.8rem}
.word{
  display:inline-block;
  margin-right:.25em;
  position:relative;
  opacity:0;
  transform:translate3d(0,100px,0) scale(.9) rotate(4deg);
}
.word.cyan{color:var(--bright-cyan)}
.word.green{color:var(--bright-green)}
.hero-subtitle{
  font-size:clamp(1rem,2vw,1.3rem);
  color:rgba(255,255,255,.9);
  max-width:900px;
  margin:1.5rem auto 0;
  line-height:1.9;
  opacity:0;
  font-weight:400;
}

/* ========== PORTFOLIO GRID ========== */
.portfolio-section{
  padding:5rem 2rem;
  background:var(--deep-navy);
}
.section-label{
  display:inline-block;
  background:linear-gradient(135deg,var(--orange),var(--yellow));
  color:var(--deep-navy);
  padding:.8rem 1.8rem;
  border-radius:999px;
  font-size:.85rem;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:2px;
  margin-bottom:1.5rem;
}
.section-title{
  font-size:clamp(2.5rem,6vw,4.5rem);
  font-weight:600;
  margin-bottom:.8rem;
  text-align:center;
  line-height:1.1;
}
.section-subtitle{
  font-size:1.2rem;
  color:rgba(255,255,255,.85);
  text-align:center;
  max-width:900px;
  margin:0 auto 4rem;
  font-weight:400;
  line-height:1.8;
}

.portfolio-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
  gap:2.5rem;
  max-width:1200px;
  margin:0 auto;
  justify-items:stretch;
}

.portfolio-card{
  position:relative;
  border-radius:18px;
  overflow:hidden;
  background:rgba(255,255,255,.04);
  backdrop-filter:blur(10px);
  border:1px solid rgba(0,212,255,.15);
  transition:.45s;
  opacity:0;
  transform:translateY(50px);
  cursor:pointer;
  display:flex;
  flex-direction:column;
  height:100%;
}
.portfolio-card::before{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(135deg,rgba(0,212,255,.2) 0%,rgba(255,107,53,.2) 100%);
  opacity:0;
  transition:.45s;
  pointer-events:none;
  z-index:3;
}
.portfolio-card:hover{
  border-color:rgba(0,212,255,.4);
  transform:translateY(-15px);
  box-shadow:0 25px 70px rgba(0,212,255,.25);
}
.portfolio-card:hover::before{opacity:1}
.portfolio-image{
  width:100%;
  height:400px;
  overflow:hidden;
  position:relative;
  background:var(--navy);
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  aspect-ratio:1/1;
}
.portfolio-image::after{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,29,61,.4) 100%);
  z-index:2;
  pointer-events:none;
}
.portfolio-image img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  transition:transform .6s;
  position:relative;
  z-index:1;
}
.portfolio-card:hover .portfolio-image img{transform:scale(1.1)}
.portfolio-info{
  padding:2.5rem;
  position:relative;
  z-index:2;
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  background:linear-gradient(180deg,rgba(0,29,61,.3) 0%,rgba(0,29,61,.85) 100%);
}
.portfolio-category{
  font-size:.8rem;
  color:var(--bright-green);
  text-transform:uppercase;
  letter-spacing:2px;
  font-weight:700;
  margin-bottom:1rem;
  display:inline-block;
  background:rgba(0,255,136,.12);
  padding:.5rem 1rem;
  border-radius:999px;
  width:fit-content;
}
.portfolio-title{
  font-size:1.6rem;
  font-weight:700;
  margin-bottom:1rem;
  color:var(--white);
  line-height:1.2;
}
.portfolio-description{
  font-size:.95rem;
  color:rgba(255,255,255,.8);
  line-height:1.7;
}

/* ========== VIDEO SHOWCASE SECTION ========== */
.video-showcase-section{
  padding:5rem 2rem;
  background:var(--navy);
  border-top:2px solid rgba(0,212,255,.15);
}
.video-showcase-title{
  font-size:clamp(2rem,5vw,3.5rem);
  font-weight:700;
  text-align:center;
  margin-bottom:3rem;
  color:var(--white);
  line-height:1.2;
}
.video-showcase-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(380px,1fr));
  gap:3rem;
  max-width:1200px;
  margin:0 auto;
}
.video-item{
  display:flex;
  flex-direction:column;
  align-items:center;
  opacity:0;
  transform:translateY(40px);
}
.video-item.animated{
  animation:slideUp 0.6s ease forwards;
}
@keyframes slideUp{
  to{opacity:1;transform:translateY(0)}
}
.video-title{
  font-size:1.3rem;
  font-weight:700;
  color:var(--bright-cyan);
  margin-bottom:1.5rem;
  text-align:center;
}
.video-wrapper{
  width:100%;
  max-width:380px;
  aspect-ratio:9/16;
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,.6);
  background:#000;
}
.video-wrapper iframe{
  width:100%;
  height:100%;
  border:none;
  display:block;
}

/* ========== DETAIL SECTIONS ========== */
.detail-section{
  padding:6rem 2rem;
  background:var(--navy);
  display:none;
  opacity:0;
  border-top:2px solid rgba(0,212,255,.2);
}
.detail-section.active{
  display:block;
  animation:revealDetail .8s ease forwards;
}
@keyframes revealDetail{to{opacity:1}}

.detail-container{
  max-width:1200px;
  margin:0 auto;
}

/* ===== SINGLE COLUMN LAYOUT - IMAGES ON TOP ===== */
.detail-header{
  display:grid;
  grid-template-columns:1fr;
  gap:3rem;
  align-items:start;
  margin-bottom:4rem;
}

.detail-images{
  display:grid;
  grid-template-columns:1fr;
  gap:2rem;
  width:100%;
}
.detail-img-main{
  width:100%;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,.5);
  height:500px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#000;
}
.detail-img-main img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}
.detail-imgs-small{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:2rem;
  margin-top:0;
}
.detail-img-small{
  width:100%;
  height:280px;
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 20px 50px rgba(0,0,0,.4);
}
.detail-img-small img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.detail-content{
  width:100%;
}
.detail-content h2{
  font-size:clamp(2.2rem,4vw,3.5rem);
  font-weight:700;
  margin-bottom:1.5rem;
  line-height:1.2;
  color:var(--white);
}
.detail-client{
  color:var(--bright-cyan);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:2px;
  margin-bottom:2rem;
  font-size:.9rem;
  display:inline-block;
  background:rgba(0,212,255,.15);
  padding:.8rem 1.8rem;
  border-radius:999px;
  border:1px solid rgba(0,212,255,.3);
}

.detail-boxes{margin-top:3rem}
.detail-box{
  margin-bottom:2.5rem;
  padding:2rem;
  background:rgba(0,212,255,.08);
  border:1px solid rgba(0,212,255,.2);
  border-radius:14px;
  transition:.3s;
}
.detail-box:hover{
  background:rgba(0,212,255,.12);
  border-color:rgba(0,212,255,.4);
}
.detail-box-label{
  color:var(--bright-green);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:2px;
  margin-bottom:1rem;
  font-size:.95rem;
  display:flex;
  align-items:center;
  gap:.6rem;
}
.detail-box-label::before{
  content:'→';
  font-size:1.3rem;
  color:var(--bright-cyan);
}
.detail-box-text{
  font-size:1.05rem;
  line-height:1.85;
  color:rgba(255,255,255,.85);
}

.detail-stats{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:2rem;
  margin-top:3rem;
  padding-top:3rem;
  border-top:1px solid rgba(0,212,255,.15);
}
.detail-stat{
  background:rgba(0,212,255,.1);
  border:1px solid rgba(0,212,255,.2);
  padding:2rem;
  border-radius:14px;
  text-align:center;
  transition:.3s;
  position:relative;
  z-index:2;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  min-height:130px;
  box-sizing:border-box;
  overflow:hidden;
}
.detail-stat:hover{
  background:rgba(0,212,255,.15);
  border-color:rgba(0,212,255,.4);
  transform:translateY(-5px);
}
.detail-stat-number{
  font-size:clamp(1.2rem,1.8vw,1.8rem);
  font-weight:700;
  color:var(--bright-cyan);
  margin-bottom:.6rem;
  line-height:1.1;
  text-align:center;
  white-space:nowrap;
  max-width:100%;
  overflow:hidden;
  text-overflow:ellipsis;
}
.detail-stat-label{
  font-size:.85rem;
  color:rgba(255,255,255,.7);
  text-transform:uppercase;
  letter-spacing:1.5px;
  font-weight:600;
  text-align:center;
  line-height:1.4;
  max-width:100%;
}

/* ========== CTA ========== */
.cta-section{
  padding:8rem 4rem;
  text-align:center;
  background:linear-gradient(135deg,var(--bright-cyan),var(--orange));
  position:relative;
  overflow:hidden;
}
.cta-section::before{
  content:'';
  position:absolute;
  inset:0;
  background:radial-gradient(circle at 20% 80%,rgba(255,107,53,.3),transparent);
  pointer-events:none;
}
.cta-title{
  font-size:clamp(2.5rem,7vw,5rem);
  font-weight:700;
  margin-bottom:1.5rem;
  color:var(--deep-navy);
  position:relative;
  z-index:2;
  line-height:1.1;
}
.cta-subtitle{
  font-size:1.5rem;
  margin-bottom:2.5rem;
  opacity:.95;
  color:var(--deep-navy);
  font-weight:500;
  position:relative;
  z-index:2;
}
.btn-primary{
  background:var(--deep-navy);
  color:var(--bright-cyan);
  padding:1.3rem 3.2rem;
  border-radius:999px;
  text-decoration:none;
  font-weight:700;
  font-size:1.1rem;
  display:inline-flex;
  align-items:center;
  gap:.8rem;
  box-shadow:0 15px 50px rgba(0,0,0,.3);
  transition:.3s;
  border:none;
  cursor:pointer;
  position:relative;
  z-index:2;
}
.btn-primary:hover{
  transform:translateY(-4px);
  box-shadow:0 20px 60px rgba(0,0,0,.4);
}

/* ========== SCROLL TOP ========== */
.scroll-top{
  position:fixed;
  bottom:30px;
  right:30px;
  width:70px;
  height:70px;
  border-radius:50%;
  z-index:9000;
  display:grid;
  place-items:center;
  cursor:pointer;
  background:conic-gradient(var(--bright-cyan) calc(var(--scroll,0)*1%),rgba(0,212,255,.15) 0);
  box-shadow:0 12px 40px rgba(0,212,255,.4),inset 0 0 0 8px rgba(0,29,61,.6);
  transform:scale(.85);
  opacity:0;
  pointer-events:none;
  transition:.3s ease;
  border:none;
}
.scroll-top.visible{
  opacity:1;
  pointer-events:auto;
  transform:scale(1);
}
.scroll-top .inner{
  width:52px;
  height:52px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:var(--navy);
  color:#fff;
  font-weight:700;
}
.scroll-top .pct{font-size:.9rem}

.floating-shape{
  z-index:0;
  pointer-events:none;
}

/* ========== RESPONSIVE ========== */
@media (max-width:1200px){
  .portfolio-grid{grid-template-columns:repeat(2,1fr)}
  .detail-stats{grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}
  .video-showcase-grid{grid-template-columns:1fr}
}

@media (max-width:768px){
  body{cursor:default}
  .cursor,.cursor-follower{display:none}
  
  .hero{padding:8rem 2rem 4rem}
  .portfolio-section{padding:3rem 1.5rem}
  .portfolio-grid{grid-template-columns:1fr;gap:1.5rem}
  .portfolio-image{height:350px}
  
  .video-showcase-section{padding:3rem 1.5rem}
  .video-showcase-grid{gap:2rem}
  .video-wrapper{max-width:100%;aspect-ratio:9/16}
  
  .detail-section{padding:4rem 1.5rem}
  .detail-header{gap:2rem}
  .detail-img-main{height:300px}
  .detail-imgs-small{grid-template-columns:1fr}
  .detail-img-small{height:250px}
  .detail-boxes{margin-top:2rem}
  .detail-box{padding:1.5rem;margin-bottom:1.5rem}
  .detail-stats{grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1.5rem;margin-top:2rem;padding-top:2rem}
  .detail-stat{min-height:110px;padding:1.5rem 1rem}
  .detail-stat-number{font-size:clamp(1.1rem,4vw,1.6rem);white-space:normal;word-wrap:break-word}
  .detail-stat-label{font-size:.75rem}
  
  .cta-section{padding:4rem 2rem}
}
</style>
</head>
<body>

<!-- Custom Cursor -->
<div class="cursor"></div>
<div class="cursor-follower"></div>

<!-- Global header include -->
<div data-include="/partials/header.html"></div>

<!-- ========== HERO ========== -->
<section class="hero">
  <div class="floating-shape shape-1" data-parallax="-12"></div>
  <div class="floating-shape shape-2" data-parallax="14"></div>
  <div class="hero-content">
    <h1 class="hero-title">
      <div class="title-line"><span class="word">Consumer</span></div>
      <div class="title-line"><span class="word cyan">Brands</span></div>
      <div class="title-line"><span class="word green">Portfolio</span></div>
    </h1>
    <p class="hero-subtitle">Building beloved brands that capture hearts, minds and market share.</p>
  </div>
</section>

<!-- ========== PORTFOLIO ========== -->
<section class="portfolio-section">
  <div style="text-align:center">
    <span class="section-label">Featured Work</span>
    <h2 class="section-title">Consumer Brands</h2>
    <p class="section-subtitle">Campaigns that humanize, entertain and drive real engagement</p>
  </div>
  <div class="portfolio-grid" id="portfolioGrid"></div>
</section>

<!-- ========== VIDEO SHOWCASE ========== -->
<section class="video-showcase-section" id="videoShowcase">
  <h2 class="video-showcase-title">Campaign Highlights</h2>
  <div class="video-showcase-grid" id="videoGrid"></div>
</section>

<!-- ========== DETAILS (ON CARD CLICK) ========== -->
<div id="detailsContainer"></div>

<!-- ========== CTA ========== -->
<section class="cta-section">
  <h2 class="cta-title">Ready to Build Your <span style="color:rgba(0,29,61,.7);">Beloved</span> Brand?</h2>
  <p class="cta-subtitle">Let's create a brand people love, talk about and come back to.</p>
  <a href="mailto:hello@savvymediaafrica.com" class="btn-primary">Start Your Project <i class="fas fa-arrow-right"></i></a>
</section>

<!-- Global footer include -->
<div data-include="/partials/footer.html"></div>

<!-- SCROLL TOP BUTTON -->
<button class="scroll-top" id="scrollTopBtn" aria-label="Back to top">
  <div class="inner"><span class="pct" id="scrollPct">0%</span></div>
</button>

<script>
gsap.registerPlugin(ScrollTrigger);

const consumerProjects = [
  {
    id:'purna',
    title:'Purna Gummies x Real Warri Pikin',
    category:'Growth',
    image:'/assets/img/purna-warri-pikin-1.jpg',
    img2:'/assets/img/purna-multivitamin.jpg',
    img3:'/assets/img/purnaa.png',
    client:'Purna Gummies',
    videoId:'1144102708',
    challenge:'Purna Gummies, a new wellness brand in Nigeria, struggled with low brand recognition, minimal digital presence and weak search traction. The goal was to rapidly move the brand from unknown to a credible, top-of-mind wellness product, ensuring high purchase intent and massive nationwide brand visibility.',
    solution:`We took over their social media account in its entirety, initiating a comprehensive digital and media launch. Our full-service strategy encompassed social media marketing, digital advertising, content marketing and influencer partnership. We anchored the campaign by securing the endorsement of beloved social media personality Real Warri Pikin. We immediately redefined the brand's voice with a relatable, humorous tone and developed a tailored content mix to build reliability and trust across all activated platforms. This cross-platform approach ensured seamless messaging and rapid audience penetration, while a robust media outreach plan secured features in top-tier national outlets like The Guardian and This Day, lending the emerging brand instant credibility.`,
    results:`The campaign achieved explosive growth and audience impact within days, successfully establishing Purna Gummies in the Nigerian wellness market. The launch generated over 60,000 total engagements in just five days and resulted in a 300% increase in Google Searches for the brand within the first 72 hours. This massive visibility and high purchase intent, coupled with 100% positive audience sentiment, solidified Purna Gummies as a recognized, credible wellness brand in Nigeria.`,
    achievements:[
      {label:'Engagements (5 days)',value:'60K+'},
      {label:'Google Searches Increase',value:'300%'},
      {label:'Positive Sentiment',value:'100%'}
    ]
  },

  {
    id:'dogtas',
    title:'Dogtas Furniture – Lagos Retail Expansion',
    category:'Retail',
    image:'/assets/img/Dogtas.png',
    img2:'/assets/img/Dogtas.png',
    img3:'/assets/img/Dogtas.png',
    client:'Dogtas Furniture',
    videoId:'1144101987',
    challenge:'Dogtas, a premium furniture brand, required a comprehensive digital strategy to solidify its market position and establish itself as a luxury household name, driving high-quality engagement and measurable sales growth.',
    solution:`We deployed an integrated digital initiative focusing on social media management and strategic digital advertising. We curated sophisticated content marketing showcasing Dogtas's superior craftsmanship and exclusive designs. Our digital advertising campaigns were strategically optimized to directly reach high-net-worth individuals and design enthusiasts, generating quality leads. We also leveraged targeted influencer efforts to authentically reinforce the brand's premium image as the premier choice for luxury living.`,
    results:`The strategic campaign successfully reinforced Dogtas's status as a luxury household name. The integrated marketing strategy resulted in increased showroom traffic and generated high-quality sales leads, firmly positioning Dogtas as the undisputed luxury furniture brand of choice for sophisticated homes.`,
    achievements:[
      {label:'Showroom Traffic',value:'Increased'},
      {label:'Sales Leads',value:'High-Quality'},
      {label:'Brand Position',value:'Premium'}
    ]
  }
];

function renderPortfolio(projects = consumerProjects){
  const grid = document.getElementById('portfolioGrid');
  grid.innerHTML = projects.map(p => `
    <div class="portfolio-card" onclick="scrollToDetail('${p.id}')">
      <div class="portfolio-image">
        <img src="${p.image}" alt="${p.title}" loading="lazy">
      </div>
      <div class="portfolio-info">
        <span class="portfolio-category">${p.category}</span>
        <h3 class="portfolio-title">${p.title}</h3>
        <p class="portfolio-description" style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">${p.challenge}</p>
      </div>
    </div>
  `).join('');

  gsap.utils.toArray('.portfolio-card').forEach((card,i)=>{
    gsap.to(card,{
      scrollTrigger:{trigger:card,start:'top 90%'},
      y:0,
      opacity:1,
      duration:0.6,
      delay:i*0.05,
      ease:'back.out(1.5)'
    });
  });
}

function renderVideos(){
  const grid = document.getElementById('videoGrid');
  grid.innerHTML = consumerProjects.filter(p => p.videoId).map(p => `
    <div class="video-item">
      <h3 class="video-title">${p.title}</h3>
      <div class="video-wrapper">
        <iframe
          src="https://player.vimeo.com/video/${p.videoId}?title=0&byline=0&portrait=0"
          allow="fullscreen; picture-in-picture"
          loading="lazy"
          title="${p.title} video"
        ></iframe>
      </div>
    </div>
  `).join('');

  // Animate video items on scroll
  gsap.utils.toArray('.video-item').forEach((item,i)=>{
    gsap.to(item,{
      scrollTrigger:{trigger:item,start:'top 80%'},
      y:0,
      opacity:1,
      duration:0.6,
      delay:i*0.1,
      ease:'back.out(1.5)'
    });
  });
}

function renderDetails(){
  const container = document.getElementById('detailsContainer');
  container.innerHTML = consumerProjects.map(p => `
    <section class="detail-section" id="detail-${p.id}">
      <div class="detail-container">
        <div class="detail-header">
          <div class="detail-images">
            <div class="detail-img-main">
              <img src="${p.image}" alt="${p.title}">
            </div>
            <div class="detail-imgs-small">
              <div class="detail-img-small"><img src="${p.img2}" alt="${p.title}"></div>
              <div class="detail-img-small"><img src="${p.img3}" alt="${p.title}"></div>
            </div>
          </div>

          <div class="detail-content">
            <div class="detail-client">${p.client}</div>
            <h2>${p.title}</h2>

            <div class="detail-boxes">
              <div class="detail-box">
                <div class="detail-box-label">Challenge</div>
                <div class="detail-box-text">${p.challenge}</div>
              </div>
              <div class="detail-box">
                <div class="detail-box-label">Solution</div>
                <div class="detail-box-text">${p.solution}</div>
              </div>
              <div class="detail-box">
                <div class="detail-box-label">Results</div>
                <div class="detail-box-text">${p.results}</div>
              </div>
            </div>

            <div class="detail-stats">
              ${p.achievements.map(s => `
                <div class="detail-stat">
                  <div class="detail-stat-number">${s.value}</div>
                  <div class="detail-stat-label">${s.label}</div>
                </div>
              `).join('')}
            </div>
          </div>
        </div>
      </div>
    </section>
  `).join('');
}

function scrollToDetail(id){
  document.querySelectorAll('.detail-section').forEach(el => el.classList.remove('active'));
  const el = document.getElementById(`detail-${id}`);
  if(el){
    el.classList.add('active');
    setTimeout(()=>el.scrollIntoView({behavior:'smooth',block:'start'}),50);
  }
}

// Custom cursor
const cursor = document.querySelector('.cursor');
const cursorFollower = document.querySelector('.cursor-follower');

document.addEventListener('mousemove',e=>{
  cursor.style.left = (e.clientX - 4) + 'px';
  cursor.style.top  = (e.clientY - 4) + 'px';
  setTimeout(()=>{
    cursorFollower.style.left = (e.clientX - 16) + 'px';
    cursorFollower.style.top  = (e.clientY - 16) + 'px';
  },60);
});

document.addEventListener('mouseover',e=>{
  if(e.target.closest('a, button, .portfolio-card')){
    cursor.style.transform = 'scale(1.6)';
    cursorFollower.style.transform = 'scale(2.2)';
  }
});

document.addEventListener('mouseout',e=>{
  if(e.target.closest('a, button, .portfolio-card')){
    cursor.style.transform = 'scale(1)';
    cursorFollower.style.transform = 'scale(1)';
  }
});

// Hero animations
gsap.to('.hero-title .word',{
  y:0,scale:1,rotation:0,opacity:1,
  duration:1,
  stagger:0.06,
  ease:'power4.out',
  delay:0.05
});
gsap.to('.hero-subtitle',{opacity:1,duration:0.8,delay:0.8});

gsap.utils.toArray('[data-parallax]').forEach(el=>{
  const amt = +el.getAttribute('data-parallax') || 10;
  gsap.to(el,{
    y:amt,
    scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}
  });
});

// Scroll top
const scrollBtn = document.getElementById('scrollTopBtn');
const scrollPct = document.getElementById('scrollPct');

function setScrollProgress(){
  const st = window.scrollY;
  const h  = document.documentElement.scrollHeight - innerHeight;
  const p  = h>0 ? Math.round((st/h)*100) : 0;
  document.documentElement.style.setProperty('--scroll',p);
  scrollBtn.style.setProperty('--scroll',p);
  scrollPct.textContent = p + '%';
  scrollBtn.classList.toggle('visible',st>380);
}

setScrollProgress();
window.addEventListener('scroll',setScrollProgress,{passive:true});
scrollBtn.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));

// Init grid + details + videos
renderPortfolio();
renderDetails();
renderVideos();
</script>

<!-- Load header/footer includes -->
<script src="/assets/js/include.js"></script>

<!-- Header scroll behaviour (waits until header.html is injected) -->
<script>
(function waitForNav(){
  const nav = document.getElementById('nav');
  if (!nav){
    requestAnimationFrame(waitForNav);
    return;
  }
  function handleNavScroll(){
    if (window.scrollY > 40){
      nav.classList.add('scrolled');
      nav.style.background = 'rgba(255,255,255,0.95)';
      nav.style.backdropFilter = 'blur(10px)';
      
      const navLinks = nav.querySelectorAll('.nav-link');
      navLinks.forEach(link => {
        link.style.color = '#001d3d';
      });
      
      const logo = nav.querySelector('.logo-text');
      if(logo) logo.style.color = '#001d3d';
      
    } else {
      nav.classList.remove('scrolled');
      nav.style.background = '';
      nav.style.backdropFilter = '';
      
      const navLinks = nav.querySelectorAll('.nav-link');
      navLinks.forEach(link => {
        link.style.color = '';
      });
      
      const logo = nav.querySelector('.logo-text');
      if(logo) logo.style.color = '';
    }
  }
  handleNavScroll();
  window.addEventListener('scroll', handleNavScroll, { passive: true });
})();
</script>

