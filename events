<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photograph viewer">
  <button class="lightbox-close" id="lbClose" type="button" aria-label="Close viewer"><i class="fas fa-times"></i></button>
  <button class="lightbox-nav lightbox-prev" id="lbPrev" type="button" aria-label="Previous photograph"><i class="fas fa-chevron-left"></i></button>
  <img id="lbImg" alt="">
  <button class="lightbox-nav lightbox-next" id="lbNext" type="button" aria-label="Next photograph"><i class="fas fa-chevron-right"></i></button>
</div>

<!-- SCROLL TOP BUTTON -->
<button class="scroll-top" id="scrollTopBtn" aria-label="Back to top">
  <div class="inner"><span class="pct" id="scrollPct">0%</span></div>
</button>

<script>
gsap.registerPlugin(ScrollTrigger);

/* ---------- lightbox ---------- */
(function(){
  const box = document.getElementById('lightbox');
  const img = document.getElementById('lbImg');
  let group = [], idx = 0;

  function show(i){
    if(!group.length) return;
    idx = (i + group.length) % group.length;
    const src = group[idx].querySelector('img');
    img.src = src.getAttribute('src');
    img.alt = src.getAttribute('alt') || '';
  }

  function open(fig){
    group = [...fig.closest('.gallery-grid').querySelectorAll('figure')];
    show(group.indexOf(fig));
    box.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function close(){
    box.classList.remove('open');
    document.body.style.overflow = '';
    /* removeAttribute, not src='' - an empty src makes the browser
       re-request the page itself as an image */
    img.removeAttribute('src');
  }

  document.querySelectorAll('.gallery-grid figure').forEach(fig=>{
    fig.addEventListener('click', ()=>open(fig));
  });

  document.getElementById('lbClose').addEventListener('click', close);
  document.getElementById('lbPrev').addEventListener('click', e=>{ e.stopPropagation(); show(idx-1); });
  document.getElementById('lbNext').addEventListener('click', e=>{ e.stopPropagation(); show(idx+1); });
  box.addEventListener('click', e=>{ if(e.target === box) close(); });

  document.addEventListener('keydown', e=>{
    if(!box.classList.contains('open')) return;
    if(e.key === 'Escape') close();
    else if(e.key === 'ArrowLeft') show(idx-1);
    else if(e.key === 'ArrowRight') show(idx+1);
  });
})();

/* ---------- custom cursor ---------- */
const cursor = document.querySelector('.cursor');
const cursorFollower = document.querySelector('.cursor-follower');

document.addEventListener('mousemove',e=>{
  cursor.style.left = (e.clientX - 4) + 'px';
  cursor.style.top  = (e.clientY - 4) + 'px';
  setTimeout(()=>{
    cursorFollower.style.left = (e.clientX - 16) + 'px';
    cursorFollower.style.top  = (e.clientY - 16) + 'px';
  },60);
});

document.addEventListener('mouseover',e=>{
  if(e.target.closest('a, button, .gallery-grid figure, .index-card')){
    cursor.style.transform = 'scale(1.6)';
    cursorFollower.style.transform = 'scale(2.2)';
  }
});

document.addEventListener('mouseout',e=>{
  if(e.target.closest('a, button, .gallery-grid figure, .index-card')){
    cursor.style.transform = 'scale(1)';
    cursorFollower.style.transform = 'scale(1)';
  }
});

/* ---------- hero + reveal animations ---------- */
gsap.to('.hero-title .word',{
  y:0,scale:1,rotation:0,opacity:1,
  duration:1,stagger:0.06,ease:'power4.out',delay:0.05
});
gsap.to('.hero-subtitle',{opacity:1,duration:0.8,delay:0.8});

gsap.utils.toArray('[data-parallax]').forEach(el=>{
  const amt = +el.getAttribute('data-parallax') || 10;
  gsap.to(el,{y:amt,scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}});
});

gsap.utils.toArray('.index-card, .detail-box, .stat, .pillar, .gallery-grid figure').forEach((el,i)=>{
  gsap.from(el,{
    scrollTrigger:{trigger:el,start:'top 92%'},
    y:34,opacity:0,duration:.55,delay:(i%6)*0.04,ease:'power2.out'
  });
});

/* ---------- scroll progress ---------- */
const scrollBtn = document.getElementById('scrollTopBtn');
const scrollPct = document.getElementById('scrollPct');

function setScrollProgress(){
  const st = window.scrollY;
  const h  = document.documentElement.scrollHeight - innerHeight;
  const p  = h > 0 ? Math.round((st / h) * 100) : 0;
  document.documentElement.style.setProperty('--scroll',p);
  scrollBtn.style.setProperty('--scroll',p);
  scrollPct.textContent = p + '%';
  scrollBtn.classList.toggle('visible',st > 380);
}

setScrollProgress();
window.addEventListener('scroll',setScrollProgress,{passive:true});
scrollBtn.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
</script>

