<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Events &amp; Experiential Programmes - Savvy Media Africa</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="description" content="High-protocol event production for institutions, brands, and international audiences across Africa.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- Global header/footer + nav styles -->
<link rel="stylesheet" href="/assets/css/savvy.css">

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}

body{
  font-family:'Sora',sans-serif;
  color:var(--white);
  background:var(--deep-navy);
  overflow-x:hidden;
  line-height:1.6;
  font-weight:400;
  cursor:none;
}

.cursor{position:fixed;width:8px;height:8px;border-radius:50%;background:var(--bright-cyan);pointer-events:none;z-index:99999;opacity:.8;transition:transform .1s ease;mix-blend-mode:screen;box-shadow:0 0 12px var(--bright-cyan),0 0 24px rgba(0,212,255,.5)}
.cursor-follower{position:fixed;width:32px;height:32px;border-radius:50%;border:1.5px solid var(--bright-cyan);pointer-events:none;z-index:99998;opacity:.4;transition:all .25s ease;box-shadow:inset 0 0 8px rgba(0,212,255,.3)}

/* ========== HERO ========== */
.hero{min-height:82vh;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;padding:12rem 4rem 5rem;overflow:hidden;background:linear-gradient(135deg,var(--deep-navy) 0%,var(--navy) 100%)}
.floating-shape{position:absolute;border-radius:50%;filter:blur(120px);opacity:.12;pointer-events:none;animation:float 20s ease-in-out infinite;z-index:0}
.shape-1{width:700px;height:700px;background:linear-gradient(135deg,var(--bright-cyan),var(--cyan));top:10%;left:5%}
.shape-2{width:600px;height:600px;background:linear-gradient(135deg,var(--orange),var(--yellow));bottom:6%;right:5%;animation-delay:-10s}
@keyframes float{0%,100%{transform:translate(0,0) scale(1)}25%{transform:translate(50px,-50px) scale(1.1)}50%{transform:translate(80px,-80px) scale(1.2)}75%{transform:translate(30px,-40px) scale(1.15)}}
.hero-content{text-align:center;max-width:1500px;position:relative;z-index:2}
.hero-title{font-size:clamp(2.6rem,8vw,6.4rem);font-weight:500;line-height:1.05;margin-bottom:1.6rem}
.title-line{display:block;margin-bottom:.6rem}
.word{display:inline-block;margin-right:.25em;position:relative;opacity:0;transform:translate3d(0,100px,0) scale(.9) rotate(4deg)}
.word.cyan{color:var(--bright-cyan)}
.word.green{color:var(--bright-green)}
.hero-subtitle{font-size:clamp(1rem,2vw,1.3rem);color:rgba(255,255,255,.9);max-width:880px;margin:1.4rem auto 0;line-height:1.9;opacity:0}

/* ========== INTRO ========== */
.intro-section{padding:5rem 2rem 1rem;background:var(--deep-navy)}
.intro-inner{max-width:1000px;margin:0 auto;text-align:center}
.section-label{display:inline-block;background:linear-gradient(135deg,var(--orange),var(--yellow));color:var(--deep-navy);padding:.8rem 1.8rem;border-radius:999px;font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:2px;margin-bottom:1.5rem}
.intro-text{font-size:clamp(1.15rem,2.2vw,1.5rem);line-height:1.85;color:rgba(255,255,255,.9);font-weight:400}
.intro-text strong{color:var(--bright-cyan);font-weight:600}

/* ========== INDEX CARDS ========== */
.index-section{padding:4rem 2rem 2rem;background:var(--deep-navy)}
.index-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem;max-width:1100px;margin:0 auto}
.index-card{display:flex;gap:1.4rem;align-items:center;padding:1.4rem;border-radius:18px;background:rgba(255,255,255,.04);border:1px solid rgba(0,212,255,.15);text-decoration:none;color:inherit;transition:.35s}
.index-card:hover{border-color:rgba(0,212,255,.45);transform:translateY(-6px);box-shadow:0 20px 50px rgba(0,212,255,.18)}
.index-thumb{width:96px;height:96px;border-radius:14px;overflow:hidden;flex-shrink:0;background:var(--navy)}
.index-thumb img{width:100%;height:100%;object-fit:cover;object-position:center 22%}
.index-cat{font-size:.72rem;color:var(--bright-green);text-transform:uppercase;letter-spacing:2px;font-weight:700;display:block;margin-bottom:.35rem}
.index-title{font-size:1.2rem;font-weight:700;line-height:1.25;margin-bottom:.3rem}
.index-meta{font-size:.82rem;color:rgba(255,255,255,.6);line-height:1.5}

/* ========== ENTRY SECTIONS ========== */
.entry{padding:6rem 2rem;border-top:2px solid rgba(0,212,255,.18)}
.entry:nth-of-type(odd){background:var(--navy)}
.entry:nth-of-type(even){background:var(--deep-navy)}
.entry-inner{max-width:1200px;margin:0 auto}

.entry-head{margin-bottom:3rem}
.entry-client{color:var(--bright-cyan);font-weight:700;text-transform:uppercase;letter-spacing:2px;font-size:.85rem;display:inline-block;background:rgba(0,212,255,.15);padding:.7rem 1.6rem;border-radius:999px;border:1px solid rgba(0,212,255,.3);margin-bottom:1.2rem}
.entry-title{font-size:clamp(2rem,4.5vw,3.4rem);font-weight:700;line-height:1.15;margin-bottom:.9rem}
.entry-meta{display:flex;flex-wrap:wrap;gap:.6rem 1.6rem;font-size:.98rem;color:rgba(255,255,255,.78);font-weight:500}
.entry-meta span{display:inline-flex;align-items:center;gap:.5rem}
.entry-meta i{color:var(--bright-green);font-size:.9rem}

/* hero image for each entry */
.entry-hero{width:100%;height:clamp(300px,42vw,520px);border-radius:18px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.5);margin-bottom:2.5rem}
.entry-hero img{width:100%;height:100%;object-fit:cover;object-position:center 25%;display:block}

/* narrative */
.entry-body{display:grid;grid-template-columns:1.15fr .85fr;gap:3rem;align-items:start}
.detail-box{margin-bottom:1.6rem;padding:1.8rem;background:rgba(0,212,255,.08);border:1px solid rgba(0,212,255,.2);border-radius:14px;transition:.3s}
.detail-box:hover{background:rgba(0,212,255,.12);border-color:rgba(0,212,255,.4)}
.detail-box-label{color:var(--bright-green);font-weight:700;text-transform:uppercase;letter-spacing:2px;margin-bottom:.8rem;font-size:.9rem;display:flex;align-items:center;gap:.6rem}
.detail-box-label::before{content:'\2192';font-size:1.2rem;color:var(--bright-cyan)}
.detail-box-text{font-size:1.05rem;line-height:1.85;color:rgba(255,255,255,.86)}

/* stats rail */
.entry-stats{display:grid;gap:1rem}
.stat{background:rgba(0,212,255,.1);border:1px solid rgba(0,212,255,.2);padding:1.6rem;border-radius:14px;transition:.3s}
.stat:hover{background:rgba(0,212,255,.15);border-color:rgba(0,212,255,.4);transform:translateY(-4px)}
.stat-number{font-size:clamp(1.3rem,2vw,1.9rem);font-weight:700;color:var(--bright-cyan);line-height:1.2;margin-bottom:.3rem}
.stat-label{font-size:.78rem;color:rgba(255,255,255,.68);text-transform:uppercase;letter-spacing:1.5px;font-weight:600}

/* scope chips */
.scope-block{margin-top:2.5rem}
.scope-heading{font-size:1.05rem;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:var(--bright-green);margin-bottom:1.2rem}
.scope-list{display:flex;flex-wrap:wrap;gap:.7rem;list-style:none}
.scope-list li{display:inline-flex;align-items:center;gap:.55rem;padding:.7rem 1.2rem;border-radius:999px;background:rgba(0,255,136,.08);border:1px solid rgba(0,255,136,.22);font-size:.92rem;font-weight:500;color:rgba(255,255,255,.9)}
.scope-list i{color:var(--bright-green);font-size:.78rem}

/* pillars */
.pillars{margin-top:2.5rem;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}
.pillar{padding:1.8rem;border-radius:16px;background:rgba(255,255,255,.04);border:1px solid rgba(0,212,255,.18);transition:.35s}
.pillar:hover{border-color:rgba(0,212,255,.42);transform:translateY(-6px)}
.pillar-num{font-size:2.2rem;font-weight:800;color:rgba(0,212,255,.35);line-height:1;margin-bottom:.6rem}
.pillar-title{font-size:1.1rem;font-weight:700;margin-bottom:.5rem;line-height:1.3}
.pillar-text{font-size:.94rem;color:rgba(255,255,255,.78);line-height:1.7}

/* gallery */
.gallery-block{margin-top:3.5rem}
.gallery-heading{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:.6rem;margin-bottom:1.4rem}
.gallery-heading h3{font-size:1.3rem;font-weight:700}
.gallery-count{font-size:.85rem;color:rgba(255,255,255,.55);font-weight:500}
.gallery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}
.gallery-grid figure{margin:0;border-radius:14px;overflow:hidden;background:var(--navy);box-shadow:0 14px 36px rgba(0,0,0,.35);cursor:pointer;transition:.35s}
.gallery-grid figure:hover{transform:translateY(-5px);box-shadow:0 22px 50px rgba(0,212,255,.22)}
.gallery-grid img{width:100%;aspect-ratio:1/1;object-fit:cover;object-position:center 20%;display:block;transition:transform .6s}
.gallery-grid figure:hover img{transform:scale(1.07)}

/* lightbox */
.lightbox{position:fixed;inset:0;z-index:9500;background:rgba(0,8,20,.94);display:none;align-items:center;justify-content:center;padding:2rem}
.lightbox.open{display:flex}
.lightbox img{max-width:min(1100px,94vw);max-height:88vh;border-radius:12px;box-shadow:0 30px 90px rgba(0,0,0,.7)}
.lightbox-close{position:absolute;top:1.2rem;right:1.4rem;width:48px;height:48px;border-radius:50%;border:1px solid rgba(0,212,255,.35);background:rgba(0,212,255,.12);color:var(--bright-cyan);font-size:1.2rem;cursor:pointer;display:flex;align-items:center;justify-content:center}
.lightbox-nav{position:absolute;top:50%;transform:translateY(-50%);width:52px;height:52px;border-radius:50%;border:1px solid rgba(0,212,255,.3);background:rgba(0,212,255,.12);color:var(--bright-cyan);font-size:1.1rem;cursor:pointer;display:flex;align-items:center;justify-content:center}
.lightbox-prev{left:1.2rem}
.lightbox-next{right:1.2rem}

/* ========== CTA ========== */
.cta-section{padding:8rem 4rem;text-align:center;background:linear-gradient(135deg,var(--bright-cyan),var(--orange));position:relative;overflow:hidden}
.cta-section::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 20% 80%,rgba(255,107,53,.3),transparent);pointer-events:none}
.cta-title{font-size:clamp(2.4rem,6.5vw,4.6rem);font-weight:700;margin-bottom:1.4rem;color:var(--deep-navy);position:relative;z-index:2;line-height:1.1}
.cta-subtitle{font-size:1.3rem;margin:0 auto 2.4rem;opacity:.95;color:var(--deep-navy);font-weight:500;position:relative;z-index:2;max-width:780px;line-height:1.7}
.btn-primary{background:var(--deep-navy);color:var(--bright-cyan);padding:1.3rem 3.2rem;border-radius:999px;text-decoration:none;font-weight:700;font-size:1.1rem;display:inline-flex;align-items:center;gap:.8rem;box-shadow:0 15px 50px rgba(0,0,0,.3);transition:.3s;position:relative;z-index:2}
.btn-primary:hover{transform:translateY(-4px);box-shadow:0 20px 60px rgba(0,0,0,.4)}

/* ========== SCROLL TOP ========== */
.scroll-top{position:fixed;bottom:30px;right:30px;width:70px;height:70px;border-radius:50%;z-index:9000;display:grid;place-items:center;cursor:pointer;background:conic-gradient(var(--bright-cyan) calc(var(--scroll,0)*1%),rgba(0,212,255,.15) 0);box-shadow:0 12px 40px rgba(0,212,255,.4),inset 0 0 0 8px rgba(0,29,61,.6);transform:scale(.85);opacity:0;pointer-events:none;transition:.3s ease;border:none}
.scroll-top.visible{opacity:1;pointer-events:auto;transform:scale(1)}
.scroll-top .inner{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--navy);color:#fff;font-weight:700}
.scroll-top .pct{font-size:.9rem}

/* ========== RESPONSIVE ========== */
@media (max-width:1100px){
  .entry-body{grid-template-columns:1fr;gap:2rem}
  .entry-stats{grid-template-columns:repeat(3,minmax(0,1fr))}
  .gallery-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}

@media (max-width:900px){
  .index-grid{grid-template-columns:1fr;max-width:560px}
  .pillars{grid-template-columns:1fr}
}

@media (max-width:768px){
  body{cursor:default}
  .cursor,.cursor-follower{display:none}

  .hero{padding:8rem 1.5rem 3.5rem;min-height:auto}
  .intro-section{padding:3.5rem 1.5rem 1rem}
  .index-section{padding:2.5rem 1.5rem 1rem}
  .entry{padding:3.5rem 1.5rem}
  .entry-stats{grid-template-columns:1fr}
  .gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}
  .detail-box{padding:1.4rem}
  .index-card{padding:1rem;gap:1rem}
  .index-thumb{width:74px;height:74px}
  .cta-section{padding:4rem 1.5rem}
  .lightbox{padding:1rem}
  .lightbox-nav{width:44px;height:44px}
}
</style>
</head>
<body>

<!-- Custom Cursor -->
<div class="cursor"></div>
<div class="cursor-follower"></div>

<!-- Global header include -->
<div data-include="/partials/header.html"></div>

<!-- ========== HERO ========== -->
<section class="hero">
  <div class="floating-shape shape-1" data-parallax="-12"></div>
  <div class="floating-shape shape-2" data-parallax="14"></div>
  <div class="hero-content">
    <h1 class="hero-title">
      <div class="title-line"><span class="word">Events &amp;</span></div>
      <div class="title-line"><span class="word cyan">Experiential</span></div>
      <div class="title-line"><span class="word green">Programmes</span></div>
    </h1>
    <p class="hero-subtitle">High-protocol event production for institutions, brands, and international audiences across Africa.</p>
  </div>
</section>

<!-- ========== INTRO ========== -->
<section class="intro-section">
  <div class="intro-inner">
    <span class="section-label">What We Do</span>
    <p class="intro-text">End-to-end event management for high-profile institutions, brands, and private clients. From concept and vendor coordination to on-ground execution — we produce experiences that <strong>reflect the calibre of the people in the room.</strong></p>
  </div>
</section>

<!-- ========== INDEX ========== -->
<section class="index-section">
  <div class="index-grid">
    <a class="index-card" href="#africa-re-sendforth">
      <div class="index-thumb"><img src="/assets/img/africa-re-sendforth-1.jpg" alt="" width="1000" height="750" loading="lazy" decoding="async"></div>
      <div>
        <span class="index-cat">Institutional Events</span>
        <div class="index-title">Executive Send-Forth Ceremony</div>
        <div class="index-meta">Africa Re &middot; Ikoyi, Lagos &middot; June 2025</div>
      </div>
    </a>
    <a class="index-card" href="#taef-afretrade">
      <div class="index-thumb"><img src="/assets/img/taef-afretrade-1.jpg" alt="" width="1024" height="1280" loading="lazy" decoding="async"></div>
      <div>
        <span class="index-cat">Continental Summits</span>
        <div class="index-title">Afretrade Entrepreneur's Festival</div>
        <div class="index-meta">TAEF &middot; Lagos, Nigeria &middot; 465K+ reach</div>
      </div>
    </a>
  </div>
</section>

<!-- ========== ENTRY 1 : AFRICA RE ========== -->
<section class="entry" id="africa-re-sendforth">
  <div class="entry-inner">

    <div class="entry-head">
      <div class="entry-client">Africa Re</div>
      <h2 class="entry-title">Executive Send-Forth Ceremony</h2>
      <div class="entry-meta">
        <span><i class="fas fa-location-dot"></i> The Colonnades Hotel, Ikoyi, Lagos</span>
        <span><i class="fas fa-calendar-days"></i> June 2025</span>
        <span><i class="fas fa-user-group"></i> 200 Guests</span>
      </div>
    </div>

    <div class="entry-hero">
      <img src="/assets/img/africa-re-sendforth-1.jpg" alt="Africa Re Executive Send-Forth Ceremony - main hall and stage" loading="lazy" decoding="async">
    </div>

    <div class="entry-body">
      <div>
        <div class="detail-box">
          <div class="detail-box-label">Brief</div>
          <div class="detail-box-text">Full-scope delivery for a pan-African institutional event.</div>
        </div>
        <div class="detail-box">
          <div class="detail-box-label">Delivery</div>
          <div class="detail-box-text">Venue sourcing, stage design, lighting, catering, entertainment, gifting, digital experience (e-invites and a QR-linked digital programme), and complete on-ground management.</div>
