<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Our Magazines - Savvy Media Africa</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/assets/css/savvy.css?v=202609122144">

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<!-- Swiper for video carousel -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}


body{
  font-family:'Sora',sans-serif;
  color:var(--white);
  background:var(--deep-navy);
  overflow-x:hidden;
  line-height:1.6;
  font-weight:400;
  cursor:none
}

.cursor{
  position:fixed;
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--bright-cyan);
  pointer-events:none;
  z-index:99999;
  opacity:.8;
  transition:transform .1s ease;
  mix-blend-mode:screen;
  box-shadow:0 0 12px var(--bright-cyan),0 0 24px rgba(0,212,255,.5)
}

.cursor-follower{
  position:fixed;
  width:32px;
  height:32px;
  border-radius:50%;
  border:1.5px solid var(--bright-cyan);
  pointer-events:none;
  z-index:99998;
  opacity:.4;
  transition:all .25s ease;
  box-shadow:inset 0 0 8px rgba(0,212,255,.3)
}

h1,h2,h3,h4,h5,h6{font-weight:500;line-height:1.1;letter-spacing:-0.02em}
h1{font-size:clamp(3rem,9vw,10rem)}
h2{font-size:clamp(2.2rem,6vw,5.5rem)}
h3{font-size:clamp(1.6rem,4vw,2.8rem)}

.underline-text{display:inline-block;position:relative;padding-bottom:6px}
.underline-text::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:4px;background:var(--bright-cyan);border-radius:2px}
.underline-orange::after{background:var(--orange)}

/* ========== NAV ========== */
nav{
  position:fixed;
  top:0;
  width:100%;
  padding:1.8rem 4rem;
  z-index:9000;
  transition:all .35s ease;
  background:transparent
}

nav .nav-container{
  max-width:1800px;
  margin:0 auto;
  display:flex;
  justify-content:flex-start;
  align-items:center;
  gap:auto;
  width:100%
}

.nav-logo{
  flex-shrink:0;
  margin-right:auto;
  text-decoration:none
}

.nav-logo img{height:50px;width:auto;display:block;filter:brightness(1) invert(0)}

.nav-links{
  display:flex;
  gap:2.6rem;
  list-style:none;
  align-items:center;
  position:static
}

.nav-links a{
  color:var(--white);
  text-decoration:none;
  font-weight:700;
  font-size:1rem;
  position:relative;
  transition:.25s
}

.nav-links a::before{
  content:'';
  position:absolute;
  bottom:-5px;
  left:0;
  width:0;
  height:3px;
  background:var(--bright-cyan);
  transition:width .25s;
  border-radius:2px
}

.nav-links a:hover::before{width:100%}
.nav-links a.active::before{width:100%}

.mobile-menu-btn{
  display:none;
  background:none;
  border:none;
  color:#fff;
  font-size:2rem;
  cursor:pointer;
  z-index:9100;
  flex-shrink:0
}

.nav-search{
  background:none;
  border:none;
  color:#fff;
  font-size:1.3rem;
  cursor:pointer;
  transition:.25s;
  margin-left:2.6rem;
  flex-shrink:0
}

.nav-search:hover{
  color:var(--bright-cyan);
  transform:scale(1.1)
}

nav.scrolled{
  background:#ffffff;
  box-shadow:0 4px 30px rgba(0,0,0,.12);
  padding:1.2rem 4rem
}

nav.scrolled .nav-links a{color:var(--navy)}
nav.scrolled .nav-links a::before{background:var(--navy)}
nav.scrolled .nav-logo img{filter:none}
nav.scrolled .nav-search{color:var(--navy)}
nav.scrolled .nav-search:hover{color:var(--bright-cyan)}
nav.scrolled .mobile-menu-btn{color:var(--navy)}

.mobile-menu{
  position:fixed;
  top:0;
  right:-100%;
  width:80%;
  max-width:300px;
  height:100vh;
  background:var(--deep-navy);
  padding:6rem 2rem 2rem;
  z-index:9050;
  transition:right .35s ease;
  overflow-y:auto;
  box-shadow:-4px 0 20px rgba(0,0,0,.5)
}

.mobile-menu.open{right:0}

.mobile-menu ul{
  list-style:none;
  display:flex;
  flex-direction:column;
  gap:2rem
}

.mobile-menu a{
  color:var(--white);
  text-decoration:none;
  font-weight:700;
  font-size:1.2rem;
  display:block;
  transition:.25s
}

.mobile-menu a:hover{color:var(--bright-cyan)}

.mobile-menu-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.5);
  z-index:9049;
  opacity:0;
  pointer-events:none;
  transition:opacity .35s ease
}

.mobile-menu-overlay.open{
  opacity:1;
  pointer-events:auto
}

/* ========== HERO ========== */
.hero{
  min-height:75vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  position:relative;
  padding:12rem 4rem 8rem;
  overflow:hidden;
  background:linear-gradient(135deg,var(--deep-navy) 0%,var(--navy) 100%)
}

.floating-shape{
  position:absolute;
  border-radius:50%;
  filter:blur(120px);
  opacity:.12;
  pointer-events:none;
  animation:float 20s ease-in-out infinite
}

.shape-1{
  width:700px;
  height:700px;
  background:linear-gradient(135deg,var(--bright-cyan),var(--cyan));
  top:10%;
  left:5%
}

.shape-2{
  width:600px;
  height:600px;
  background:linear-gradient(135deg,var(--orange),var(--yellow));
  bottom:6%;
  right:5%;
  animation-delay:-10s
}

@keyframes float{
  0%,100%{transform:translate(0,0) scale(1)}
  25%{transform:translate(50px,-50px) scale(1.1)}
  50%{transform:translate(80px,-80px) scale(1.2)}
  75%{transform:translate(30px,-40px) scale(1.15)}
}

.hero-content{text-align:center;max-width:1200px;position:relative;z-index:2}

.hero-label{
  display:inline-block;
  background:linear-gradient(135deg,var(--orange),var(--yellow));
  color:var(--deep-navy);
  padding:.7rem 1.6rem;
  border-radius:999px;
  font-size:.88rem;
  font-weight:500;
  text-transform:uppercase;
  letter-spacing:2px;
  margin-bottom:1.2rem;
  opacity:0;
  transform:translateY(20px)
}

.hero-title{
  font-family:'Sora',sans-serif;
  font-size:clamp(3rem,8vw,7rem);
  font-weight:500;
  line-height:1.1;
  margin-bottom:1.6rem;
  opacity:0;
  transform:translateY(50px)
}

.hero-subtitle{
  font-size:clamp(1.1rem,2vw,1.4rem);
  color:rgba(255,255,255,.9);
  max-width:800px;
  margin:0 auto;
  line-height:1.8;
  opacity:0;
  transform:translateY(30px);
  font-weight:400
}

/* ========== MAGAZINE GRID ========== */
.magazines-section{
  padding:8rem 2rem;
  background:var(--deep-navy)
}

.magazines-container{
  max-width:1600px;
  margin:0 auto
}

.section-header{
  text-align:center;
  margin-bottom:5rem;
  opacity:0;
  transform:translateY(40px)
}

.section-label{
  display:inline-block;
  background:linear-gradient(135deg,var(--bright-cyan),var(--cyan));
  color:var(--deep-navy);
  padding:.7rem 1.6rem;
  border-radius:999px;
  font-size:.88rem;
  font-weight:500;
  text-transform:uppercase;
  letter-spacing:2px;
  margin-bottom:1.2rem
}

.section-title{
  font-size:clamp(2.5rem,5vw,4.5rem);
  margin-bottom:1rem;
  color:var(--white)
}

.section-description{
  font-size:1.2rem;
  color:rgba(255,255,255,.85);
  max-width:700px;
  margin:0 auto;
  line-height:1.7
}

.magazines-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(350px,1fr));
  gap:3rem;
  margin-bottom:4rem
}

.magazine-card{
  position:relative;
  border-radius:20px;
  overflow:hidden;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(0,212,255,.15);
  transition:.4s;
  opacity:0;
  transform:translateY(40px);
  cursor:pointer;
  aspect-ratio:3/4;
  display:flex;
  flex-direction:column
}

.magazine-card:hover{
  transform:translateY(-10px);
  border-color:rgba(0,212,255,.4);
  box-shadow:0 20px 60px rgba(0,212,255,.2)
}

.magazine-image-wrapper{
  position:absolute;
  inset:0;
  overflow:hidden;
  z-index:1
}

.magazine-image{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  transition:.5s
}

.magazine-card:hover .magazine-image{
  transform:scale(1.05)
}

.magazine-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(to top,rgba(0,29,61,.95) 0%,transparent 60%);
  opacity:0;
  transition:.4s;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  padding:2rem
}

.magazine-card:hover .magazine-overlay{
  opacity:1
}

.edition-label{
  position:absolute;
  top:1.5rem;
  left:1.5rem;
  background:var(--yellow);
  color:var(--deep-navy);
  padding:.6rem 1.2rem;
  border-radius:8px;
  font-size:.85rem;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:1px;
  z-index:2
}

.magazine-info{
  position:absolute;
  bottom:0;
  left:0;
  right:0;
  padding:1.5rem;
  background:rgba(0,29,61,.9);
  backdrop-filter:blur(10px);
  border-top:1px solid rgba(0,212,255,.15);
  z-index:2;
  transition:.3s
}

.magazine-title{
  font-size:1.3rem;
  color:var(--white);
  margin-bottom:.5rem;
  font-weight:600
}

.magazine-description{
  font-size:.95rem;
  color:rgba(255,255,255,.8);
  margin-bottom:1rem;
  line-height:1.6
}

.download-btn{
  display:inline-flex;
  align-items:center;
  gap:.8rem;
  padding:.8rem 1.5rem;
  background:linear-gradient(135deg,var(--bright-cyan),var(--cyan));
  color:var(--deep-navy);
  text-decoration:none;
  border-radius:8px;
  font-weight:600;
  font-size:.95rem;
  transition:.3s;
  border:none;
  cursor:pointer
}

.download-btn:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 20px rgba(0,212,255,.4)
}

.magazine-overlay .download-btn{
  background:var(--white);
  color:var(--deep-navy);
  align-self:flex-start
}

/* ========== VIDEO CAROUSEL ========== */
.videos-section{
  margin-top:5rem;
  padding:4rem 2rem 3rem;
  border-radius:24px;
  background:
    radial-gradient(circle at top left,rgba(0,212,255,.16),transparent 55%),
    radial-gradient(circle at bottom right,rgba(255,107,53,.18),transparent 55%);
  border:1px solid rgba(0,212,255,.22);
  opacity:0;
  transform:translateY(40px);
}

.videos-inner{
  max-width:1600px;
  margin:0 auto;
}

.videos-header{
  text-align:center;
  margin-bottom:3rem;
}

.videos-tag{
  display:inline-block;
  padding:.5rem 1.3rem;
  border-radius:999px;
  font-size:.8rem;
  letter-spacing:2px;
  text-transform:uppercase;
  background:rgba(0,212,255,.12);
  border:1px solid rgba(0,212,255,.35);
  color:var(--bright-cyan);
  margin-bottom:.9rem;
}

.videos-title{
  font-size:clamp(2rem,4vw,3.2rem);
  margin-bottom:.6rem;
}

.videos-subtitle{
  font-size:1rem;
  color:rgba(255,255,255,.8);
  max-width:620px;
  margin:0 auto;
}

.videos-carousel{
  position:relative;
  padding:0 1rem 3.2rem;
}

.video-card{
  background:rgba(0,29,61,.96);
  border-radius:18px;
  padding:1rem 1rem 1.4rem;
  border:1px solid rgba(0,212,255,.26);
  box-shadow:0 20px 60px rgba(0,0,0,.45);
  display:flex;
  flex-direction:column;
  gap:1rem;
}

.video-frame{
  position:relative;
  width:100%;
  border-radius:14px;
  overflow:hidden;
  background:#000;
  aspect-ratio:16/9;
}

.video-frame iframe{
  width:100%;
  height:100%;
  border:0;
}

.video-meta{
  display:flex;
  flex-direction:column;
  gap:.3rem;
}

.video-meta h3{
  font-size:1.05rem;
  font-weight:600;
}

.video-meta p{
  font-size:.9rem;
  color:rgba(255,255,255,.75);
}

/* Swiper controls */
.videos-carousel .swiper-button-next,
.videos-carousel .swiper-button-prev{
  width:44px;
  height:44px;
  border-radius:999px;
  background:rgba(0,29,61,.9);
  border:1px solid rgba(0,212,255,.6);
  color:#fff;
  top:50%;
  transform:translateY(-50%);
  box-shadow:0 12px 30px rgba(0,0,0,.4);
}

.videos-carousel .swiper-button-next:after,
.videos-carousel .swiper-button-prev:after{
  font-size:1.1rem;
  font-weight:700;
}

.videos-carousel .swiper-button-next:hover,
.videos-carousel .swiper-button-prev:hover{
  background:var(--bright-cyan);
  color:var(--deep-navy);
}

.videos-carousel .swiper-pagination-bullet{
  background:rgba(0,212,255,.4);
  opacity:1;
}

.videos-carousel .swiper-pagination-bullet-active{
  background:var(--bright-cyan);
  width:18px;
  border-radius:999px;
}

/* ========== STATS SECTION ========== */
.stats-section{
  padding:6rem 2rem;
  background:var(--navy);
  text-align:center
}

.stats-container{
  max-width:1200px;
  margin:0 auto
}

.stats-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:3rem;
  margin-top:3rem
}

.stat-item{
  opacity:0;
  transform:translateY(30px)
}

.stat-number{
  font-size:clamp(2.5rem,5vw,4rem);
  font-weight:700;
  color:var(--bright-cyan);
  margin-bottom:.5rem;
  line-height:1
}

.stat-label{
  font-size:1.1rem;
  color:rgba(255,255,255,.85);
  text-transform:uppercase;
  letter-spacing:1px
}

/* ========== FOOTER ========== */
footer{
  background:var(--deep-navy);
  padding:4rem 2rem 2rem;
  border-top:1px solid rgba(0,212,255,.15)
}

.footer-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:4.6rem;
  max-width:1600px;
  margin:0 auto 3.6rem
}

.footer-brand h3{font-size:2.3rem;font-weight:500;margin-bottom:.8rem}

.footer-brand p{
  color:rgba(255,255,255,.7);
  line-height:1.9;
  margin-bottom:1.4rem;
  font-weight:400
}

.footer-column h4{font-size:1.15rem;margin-bottom:.8rem;font-weight:500}
.footer-links{list-style:none}
.footer-links li{margin-bottom:.6rem}

.footer-links a{
  color:rgba(255,255,255,.75);
  text-decoration:none;
  transition:.25s;
  font-weight:400
}

.footer-links a:hover{
  color:var(--bright-cyan);
  padding-left:8px
}

.social-links{
  display:flex;
  gap:1rem;
  margin-top:1.5rem
}

.social-link{
  width:50px;
  height:50px;
  background:rgba(0,212,255,.1);
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  transition:.25s;
  border:1px solid rgba(0,212,255,.2);
  text-decoration:none;
  font-size:1.2rem
}

.social-link:hover{
  background:var(--bright-cyan);
  color:var(--deep-navy);
  transform:translateY(-3px) rotate(360deg);
  border-color:var(--bright-cyan)
}

.footer-bottom{
  border-top:1px solid rgba(0,212,255,.15);
  padding-top:1.6rem;
  text-align:center;
  color:rgba(255,255,255,.65);
  font-weight:400
}

/* ========== SCROLL TOP ========== */
.scroll-top{
  position:fixed;
  bottom:26px;
  right:26px;
  width:68px;
  height:68px;
  border-radius:50%;
  z-index:9000;
  display:grid;
  place-items:center;
  cursor:pointer;
  background:conic-gradient(var(--bright-cyan) calc(var(--scroll,0)*1%),rgba(0,212,255,.15) 0);
  box-shadow:0 12px 35px rgba(0,212,255,.38),inset 0 0 0 8px rgba(0,29,61,.5);
  transform:scale(.9);
  opacity:0;
  pointer-events:none;
  transition:.25s ease;
  border:none
}

.scroll-top.visible{
  opacity:1;
  pointer-events:auto;
  transform:scale(1)
}

.scroll-top .inner{
  width:50px;
  height:50px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:var(--navy);
  color:#fff;
  font-weight:500
}

.scroll-top .pct{font-size:.92rem}

/* ========== RESPONSIVE ========== */
@media (max-width:1024px){
  nav{padding:1.4rem 2rem}
  .magazines-grid{grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:2rem}
  .footer-grid{grid-template-columns:1fr 1fr}
}

@media (max-width:768px){
  nav{padding:1.2rem 2rem}
  nav .nav-container{justify-content:space-between}
  .nav-links{display:none}
  .mobile-menu-btn{display:block;order:3}
  .nav-search{order:2;margin-left:auto;margin-right:1rem}
  .nav-logo{order:1}
  
  .magazines-grid{grid-template-columns:1fr;gap:2rem}
  .stats-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr}

  .videos-section{
    padding:3rem 1.5rem 2.8rem;
  }
  .videos-carousel{
    padding:0 .5rem 3rem;
  }
  
  body{cursor:default}
  .cursor,.cursor-follower{display:none}
}

@media (max-width:480px){
  .videos-carousel .swiper-button-next,
  .videos-carousel .swiper-button-prev{
    display:none;
  }
}
</style>
</head>
<body>

<!-- Custom Cursor -->
<div class="cursor"></div>
<div class="cursor-follower"></div>
<!-- HEADER INCLUDE -->
<div data-include="/partials/header.html"></div>

<!-- ========== NAV ========== -->


<!-- Mobile Menu -->


<!-- ========== HERO ========== -->
<section class="hero">
  <div class="floating-shape shape-1"></div>
  <div class="floating-shape shape-2"></div>

  <div class="hero-content">
    <span class="hero-label">Our Magazines</span>
    <h1 class="hero-title">Stories That <span class="underline-text">Define</span> African Youth</h1>
    <p class="hero-subtitle">A hub for Nigerian youths to exchange and celebrate youth-focused dialogue, ideas, and culture through compelling magazine editions.</p>
  </div>
</section>

<!-- ========== MAGAZINE GRID ========== -->
<section class="magazines-section">
  <div class="magazines-container">
    
    <div class="section-header">
      <span class="section-label">Magazine Archives</span>
      <h2 class="section-title">Explore Our <span class="underline-text underline-orange">Editions</span></h2>
      <p class="section-description">From cultural conversations to bold voices shaping the future—download and read our past editions.</p>
    </div>

    <div class="magazines-grid">
      <!-- Magazine cards (unchanged) -->
      <!-- Magazine 1: 17th Edition -->
      <div class="magazine-card">
        <div class="edition-label">17th Edition</div>
        <div class="magazine-image-wrapper">
          <img src="/assets/img/savvy-17th-edition.jpg" alt="17th Edition" class="magazine-image">
          <div class="magazine-overlay">
            <a href="https://drive.google.com/file/d/1JaxaT6CclrQplIreMyzaRjhIFHdjjX3a/view?usp=sharing" target="_blank" class="download-btn">
              <i class="fas fa-book-open"></i>
              Read Magazine
            </a>
          </div>
        </div>
        <div class="magazine-info">
          <h3 class="magazine-title">On A Path to Self-Discovery</h3>
          <p class="magazine-description">Featuring Ilebaye - exploring identity, growth, and the journey to self-awareness.</p>
          <a href="https://drive.google.com/file/d/1JaxaT6CclrQplIreMyzaRjhIFHdjjX3a/view?usp=sharing" target="_blank" class="download-btn">
            <i class="fas fa-book-open"></i>
            Read Magazine
          </a>
        </div>
      </div>

      <!-- Magazine 2: 16th Edition -->
      <div class="magazine-card">
        <div class="edition-label">16th Edition</div>
