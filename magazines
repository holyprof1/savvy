<script>
  gsap.registerPlugin(ScrollTrigger);

  // Custom Cursor
  const cursor = document.querySelector('.cursor');
  const cursorFollower = document.querySelector('.cursor-follower');
  
  document.addEventListener('mousemove', (e) => {
    cursor.style.left = (e.clientX - 4) + 'px';
    cursor.style.top = (e.clientY - 4) + 'px';
    
    setTimeout(() => {
      cursorFollower.style.left = (e.clientX - 16) + 'px';
      cursorFollower.style.top = (e.clientY - 16) + 'px';
    }, 60);
  });

  document.addEventListener('mouseover', (e) => {
    const interactive = e.target.closest('a, button, .magazine-card, .swiper-slide');
    if (interactive) {
      cursor.style.transform = 'scale(1.6)';
      cursor.style.opacity = '1';
      cursorFollower.style.transform = 'scale(2.2)';
      cursorFollower.style.borderColor = 'var(--bright-cyan)';
      cursorFollower.style.boxShadow = '0 0 16px var(--bright-cyan), inset 0 0 12px rgba(0,212,255,.4)';
    }
  });

  document.addEventListener('mouseout', (e) => {
    const interactive = e.target.closest('a, button, .magazine-card, .swiper-slide');
    if (interactive) {
      cursor.style.transform = 'scale(1)';
      cursor.style.opacity = '0.8';
      cursorFollower.style.transform = 'scale(1)';
      cursorFollower.style.borderColor = 'var(--bright-cyan)';
      cursorFollower.style.boxShadow = 'inset 0 0 8px rgba(0,212,255,.3)';
    }
  });

  // Navigation scroll behavior
const nav = document.getElementById('nav');

if (nav) {
  window.addEventListener('scroll', () => {
    if (window.scrollY > 100) {
      nav.classList.add('scrolled');
    } else {
      nav.classList.remove('scrolled');
    }
  });
}

  // Nav, mobile menu and search are handled globally by include.js


  // GSAP Animations
  gsap.to('.hero-label',{opacity:1,y:0,duration:.8,delay:.2,ease:'power3.out'});
  gsap.to('.hero-title',{opacity:1,y:0,duration:1,delay:.4,ease:'power3.out'});
  gsap.to('.hero-subtitle',{opacity:1,y:0,duration:1,delay:.6,ease:'power3.out'});

  gsap.to('.section-header',{
    scrollTrigger:{trigger:'.magazines-section',start:'top 80%'},
    opacity:1,y:0,duration:.8,ease:'power3.out'
  });

  gsap.to('.magazine-card',{
    scrollTrigger:{trigger:'.magazines-grid',start:'top 80%'},
    opacity:1,y:0,duration:.8,stagger:.1,ease:'power3.out'
  });

  gsap.to('.videos-section',{
    scrollTrigger:{trigger:'.videos-section',start:'top 80%'},
    opacity:1,y:0,duration:.9,ease:'power3.out'
  });

  gsap.to('.stat-item',{
    scrollTrigger:{trigger:'.stats-section',start:'top 80%'},
    opacity:1,y:0,duration:.8,stagger:.15,ease:'power3.out'
  });

  // Swiper: video carousel
  const videoSwiper = new Swiper('.videos-carousel', {
    slidesPerView: 1.1,
    spaceBetween: 24,
    loop: true,
    grabCursor: true,
    navigation: {
      nextEl: '.videos-carousel .swiper-button-next',
      prevEl: '.videos-carousel .swiper-button-prev',
    },
    pagination: {
      el: '.videos-carousel .swiper-pagination',
      clickable: true,
    },
    breakpoints: {
      768: {
        slidesPerView: 2,
        spaceBetween: 24,
      },
      1024: {
        slidesPerView: 3,
        spaceBetween: 28,
      },
    }
  });

  // Scroll-to-top
  const scrollBtn=document.getElementById('scrollTopBtn');
  const scrollPct=document.getElementById('scrollPct');

  function setScrollProgress(){
    const st=window.scrollY;
    const h=document.documentElement.scrollHeight - innerHeight;
    const p=h>0?Math.round((st/h)*100):0;
    document.documentElement.style.setProperty('--scroll',p);
    scrollBtn.style.setProperty('--scroll',p);
    scrollPct.textContent=p+'%';
    
    if(st>380){
      scrollBtn.classList.add('visible');
    } else {
      scrollBtn.classList.remove('visible');
    }
  }

  setScrollProgress();
  window.addEventListener('scroll',setScrollProgress,{passive:true});
  scrollBtn.addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));
</script>
