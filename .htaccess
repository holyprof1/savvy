# ==========================================================
# Savvy Media Africa
# ==========================================================

# ---- Default document ----
DirectoryIndex index.html

# ---- Extensionless pages ----
# about, work, film, corporate, consumer, contact, magazines, events have
# no file extension, so Apache sends no Content-Type and the browser has
# to guess. With X-Content-Type-Options: nosniff set below it cannot even
# guess, so declare them as HTML explicitly. Any new extensionless page
# MUST be added here and to the Cache-Control block below.
<FilesMatch "^(about|work|film|corporate|consumer|contact|magazines|events)$">
  ForceType text/html
  Header set Content-Type "text/html; charset=UTF-8"
</FilesMatch>

# ---- Character set ----
AddDefaultCharset UTF-8

# ---- Custom error page ----
ErrorDocument 404 /index.html

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On

  # Fingerprint-free assets: a month, long enough to help, short enough to fix
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"

  # Pages must stay fresh
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Pages are regenerated by hand — don't let a proxy pin an old one
  <FilesMatch "\.(html)$|^(about|work|film|corporate|consumer|contact|magazines|events)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Protect dotfiles and internals ----
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(md|json|lock)$">
  Require all denied
</FilesMatch>

# ---- Directory listings off ----
Options -Indexes

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
